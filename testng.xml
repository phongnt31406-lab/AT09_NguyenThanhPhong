<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Suite toàn bộ project. Chế độ parallel và số thread được SuiteConfigListener
  ghi đè từ configs/config.properties (parallel.mode, thread.count, dataprovider.thread.count)
  hoặc từ dòng lệnh: mvn test -Dthread.count=5
-->
<suite name="RISE CRM - Regression" parallel="methods" thread-count="3" data-provider-thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.rise.listeners.SuiteConfigListener"/>
        <listener class-name="com.rise.listeners.TestListener"/>
        <listener class-name="com.rise.listeners.ReportListener"/>
    </listeners>

    <test name="RISE CRM - All modules">
        <packages>
            <package name="com.rise.tests.*"/>
        </packages>
    </test>
</suite>
