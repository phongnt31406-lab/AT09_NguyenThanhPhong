<?xml version="1.0" encoding="UTF-8"?>
<!-- Log ra console + file reports/logs/rise-automation.log; [%t] = tên thread để đọc log khi chạy parallel -->
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_DIR">reports/logs</Property>
        <Property name="PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}" charset="UTF-8"/>
        </Console>
        <RollingFile name="File" fileName="${LOG_DIR}/rise-automation.log"
                     filePattern="${LOG_DIR}/rise-automation-%d{yyyyMMdd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}" charset="UTF-8"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.rise" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Logger name="org.apache.poi" level="WARN"/>
        <Logger name="io.qameta.allure" level="WARN"/>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
