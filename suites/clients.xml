<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Chỉ chạy module Clients & Contacts: mvn clean test -DsuiteXmlFile=suites/clients.xml -->
<suite name="RISE CRM - Clients" parallel="methods" thread-count="3" data-provider-thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.rise.listeners.SuiteConfigListener"/>
        <listener class-name="com.rise.listeners.TestListener"/>
        <listener class-name="com.rise.listeners.ReportListener"/>
    </listeners>

    <test name="Clients &amp; Contacts">
        <packages>
            <package name="com.rise.tests.clients"/>
        </packages>
    </test>
</suite>
